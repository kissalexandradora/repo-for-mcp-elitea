{
  "name": "epam-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright TypeScript tests for EPAM website",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
